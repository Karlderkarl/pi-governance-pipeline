{
  "name": "pi-governance-pipeline",
  "version": "1.2.1",
  "description": "Turns a PRD into project governance (SOUL.md, AGENTS.md, SYSTEM.md, MEMORY.md) and runs an issue-driven auto-develop pipeline from that governance: per-role model routing, independent multi-model review, severity-based gating, hard run budgets. The pipeline ships in the package; the skill configures it.",
  "keywords": [
    "pi-package",
    "pi-skill",
    "governance",
    "prd",
    "agents-md",
    "multi-model-review",
    "auto-develop",
    "pipeline"
  ],
  "license": "MIT",
  "author": "Karlderkarl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karlderkarl/pi-governance-pipeline.git"
  },
  "homepage": "https://github.com/Karlderkarl/pi-governance-pipeline#readme",
  "bugs": "https://github.com/Karlderkarl/pi-governance-pipeline/issues",
  "type": "module",
  "bin": {
    "pi-governance-pipeline": "bin/pipeline.mjs"
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "extensions",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "smoke": "bash tests/smoke.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./extensions"
    ],
    "prompts": [
      "./prompts"
    ]
  }
}
